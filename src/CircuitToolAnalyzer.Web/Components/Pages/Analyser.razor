@using CircuitToolAnalyzer.Application.DTOs
@using System.Net.Http.Json
@using CircuitToolAnalyzer.Web.Models
@page "/analyser"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<h3>Analyser</h3>

@code {
    double voltage = 0.0;
    double r1 = 0.0;
    double r2 = 0.0;
    AnalysisResultResponse? result = null;

    private async Task Works()
    {
        Console.WriteLine("2");
    }

    private async Task CalculateCurrent()
    {
        Console.WriteLine("Botón presionado");
        var dto = new CircuitRequestDto
        {
            Name = "Circuito desde Web",
            Nodes = new List<NodeDto>
    {
        new NodeDto { Name = "V0", IsGround = false },
        new NodeDto { Name = "GND", IsGround = true }
    },
            Connections = new List<ConnectionDto>
    {
        new ConnectionDto { ComponentName = "Fuente1", ComponentType = ComponentType.VoltageSource, Value = voltage, NodeAName = "V0", NodeBName = "GND" },
        new ConnectionDto { ComponentName = "R1", ComponentType = ComponentType.Resistor, Value = r1, NodeAName = "V0", NodeBName = "V1" },
    }
        };
        var client = HttpClientFactory.CreateClient("CircuitApi");
        var response = await client.PostAsJsonAsync("api/CircuitAnalysis", dto);

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Error: {response.StatusCode}");
            return;
        }

        result = await response.Content.ReadFromJsonAsync<AnalysisResultResponse>();
        StateHasChanged();
    }
}

<input type="number" @bind="voltage" placeholder="Voltage (V)" />
<input type="number" @bind="r1" placeholder="Resistance R1 (Ω)" />
<input type="number" @bind="r2" placeholder="Resistance R2 (Ω)" />

<button @onclick="Works">Calculate Current</button>

@if (result != null)
{
    <div>
        <h4>Results:</h4>
        @foreach (var voltaje in result.NodeVoltages)
        {
            <p>Nodo @voltaje.Key: @voltaje.Value V</p>
        }
    </div>
}